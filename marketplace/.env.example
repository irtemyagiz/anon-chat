APP_NAME=Katman
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=tr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=tr_TR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# XAMPP varsayılanı: MariaDB, kullanıcı root, şifre boş. cPanel'de kendi değerlerinizi girin.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=marketplace
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Yerel geliştirmede "sync": dosya taraması gibi işler hemen çalışır.
# Production'da "database" kullanın ve cron ile queue:work çalıştırın (bkz. docs/KURULUM.md).
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Pazaryeri ayarları (varsayılanlar; çoğu yönetim panelinden değiştirilebilir)
# ---------------------------------------------------------------------------
MARKETPLACE_MINIMUM_TOP_UP_POINTS=500
MARKETPLACE_COMMISSION_BPS=2000
MARKETPLACE_EARNING_HOLD_DAYS=14
MARKETPLACE_MINIMUM_PAYOUT_CENTS=5000

# Döviz kuru (Frankfurter / ECB, API anahtarı gerekmez)
EXCHANGE_RATE_PROVIDER=frankfurter
EXCHANGE_RATE_UPDATE_MINUTES=60
EXCHANGE_RATE_CACHE_TTL=900
EXCHANGE_RATE_MAX_AGE_HOURS=48

# Dosya depolama: ücretli dosyalar asla "public" diskte tutulmaz.
PRODUCT_FILES_DISK=private
PUBLIC_MEDIA_DISK=public
DOWNLOAD_LINK_TTL_MINUTES=10
MAX_PRODUCT_FILE_MB=500

# Ödeme: sandbox yalnızca geliştirme/test içindir, production'da çalışmaz.
# Uzun rastgele bir değer üretin: php -r "echo bin2hex(random_bytes(32));"
SANDBOX_PAYMENT_SECRET=

# Zararlı dosya taraması: production'da "clamav" önerilir (sunucuda ClamAV gerekir).
FILE_SCANNER=none
CLAMAV_BINARY=clamdscan
MAX_PREVIEW_FILE_MB=30
MARKETPLACE_PRODUCTS_REQUIRE_REVIEW=true
